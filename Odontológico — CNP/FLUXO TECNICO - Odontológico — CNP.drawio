<mxfile host="app.diagrams.net" modified="2026-11-12T11:30:00.000Z" agent="Copilot SDK in VS Code" version="24.7.17" type="device"><diagram id="fluxo-2" name="Fluxo técnico"><mxGraphModel dx="1200" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1654" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n1" value="&lt;b&gt;Início&lt;/b&gt;&lt;br&gt;Cliente adere pelo canal Senff; validações prévias podem consultar Cerberus." style="ellipse;whiteSpace=wrap;html=1;fillColor=#E0F2FF;strokeColor=#1D58EE;fontColor=#0B1C54;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="220" y="45" width="730" height="78" as="geometry" /></mxCell><mxCell id="n2" value="&lt;b&gt;Contratação · API Private&lt;/b&gt;&lt;br&gt;POST /api/v1/private/contrato cria ContratoSeguro pendente (P) e aplica regras do produto." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F9FC;strokeColor=#173288;fontColor=#26292C;fontSize=13;align=center;verticalAlign=middle;spacing=10;arcSize=12;" vertex="1" parent="1"><mxGeometry x="220" y="163" width="730" height="78" as="geometry" /></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#686D73;strokeWidth=2;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n3" value="&lt;b&gt;Ativação e adesão&lt;/b&gt;&lt;br&gt;AtivarContratoSeguroPrivatePF processa o contrato. OdontologicoJob registra adesão do plano no Legado, busca endereço e envia WhatsApp via ApiHi." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F9FC;strokeColor=#173288;fontColor=#26292C;fontSize=13;align=center;verticalAlign=middle;spacing=10;arcSize=12;" vertex="1" parent="1"><mxGeometry x="220" y="281" width="730" height="78" as="geometry" /></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#686D73;strokeWidth=2;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n4" value="&lt;b&gt;Lote para CNP · SFTP&lt;/b&gt;&lt;br&gt;Worker gera lote, consolida dados e monta arquivo; guarda cópia no SFTP interno e envia ao SFTP da CNP." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBEBFD;strokeColor=#4345DE;fontColor=#26292C;fontSize=13;align=center;verticalAlign=middle;spacing=10;arcSize=12;" vertex="1" parent="1"><mxGeometry x="220" y="399" width="730" height="78" as="geometry" /></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#686D73;strokeWidth=2;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n5" value="&lt;b&gt;Retorno CNP&lt;/b&gt;&lt;br&gt;Worker baixa/processa arquivo de resposta e atualiza o status do lote odontológico." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEBE2;strokeColor=#E06D36;fontColor=#26292C;fontSize=13;align=center;verticalAlign=middle;spacing=10;arcSize=12;" vertex="1" parent="1"><mxGeometry x="220" y="517" width="730" height="78" as="geometry" /></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#686D73;strokeWidth=2;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n6" value="&lt;b&gt;Cobrança mensal&lt;/b&gt;&lt;br&gt;Cobrança recorrente Private; cálculo odontológico considera titular + dependentes; lançamento vai para a fatura Senff." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F9FC;strokeColor=#173288;fontColor=#26292C;fontSize=13;align=center;verticalAlign=middle;spacing=10;arcSize=12;" vertex="1" parent="1"><mxGeometry x="220" y="635" width="730" height="78" as="geometry" /></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#686D73;strokeWidth=2;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n7" value="&lt;b&gt;Cancelamento&lt;/b&gt;&lt;br&gt;POST /api/v1/private/cancelar; fluxo Private cancela no SENFF/Legado e pode tratar estorno pelo Pagamento." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEBE2;strokeColor=#E06D36;fontColor=#26292C;fontSize=13;align=center;verticalAlign=middle;spacing=10;arcSize=12;" vertex="1" parent="1"><mxGeometry x="220" y="753" width="730" height="78" as="geometry" /></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#686D73;strokeWidth=2;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n8" value="&lt;b&gt;Fim&lt;/b&gt;&lt;br&gt;Contrato A enquanto ativo; C ao cancelar. Erro de SFTP deixa lote em erro para reprocessamento." style="ellipse;whiteSpace=wrap;html=1;fillColor=#E3F2E4;strokeColor=#06760B;fontColor=#0B1C54;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="220" y="871" width="730" height="78" as="geometry" /></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#686D73;strokeWidth=2;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>