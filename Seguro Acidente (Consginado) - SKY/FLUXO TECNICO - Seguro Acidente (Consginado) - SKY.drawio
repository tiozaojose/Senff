<mxfile host="app.diagrams.net" modified="2026-11-12T11:30:00.000Z" agent="Copilot SDK in VS Code" version="24.7.17" type="device"><diagram id="fluxo-7" name="Fluxo técnico"><mxGraphModel dx="1200" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1654" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n1" value="&lt;b&gt;Início&lt;/b&gt;&lt;br&gt;Canal consulta elegibilidade do seguro consignado." style="ellipse;whiteSpace=wrap;html=1;fillColor=#E0F2FF;strokeColor=#1D58EE;fontColor=#0B1C54;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="220" y="45" width="730" height="78" as="geometry" /></mxCell><mxCell id="n2" value="&lt;b&gt;Consulta · API&lt;/b&gt;&lt;br&gt;GET /api/v1/consignado/seguros-disponiveis aplica regras por tipo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F9FC;strokeColor=#173288;fontColor=#26292C;fontSize=13;align=center;verticalAlign=middle;spacing=10;arcSize=12;" vertex="1" parent="1"><mxGeometry x="220" y="163" width="730" height="78" as="geometry" /></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#686D73;strokeWidth=2;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n3" value="&lt;b&gt;Contratação · API → Sky&lt;/b&gt;&lt;br&gt;POST /api/v1/consignado/contrato; ConsignadoFactory encaminha à Sky produtos fora do ramo prestamista, segundo o mapa." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBEBFD;strokeColor=#4345DE;fontColor=#26292C;fontSize=13;align=center;verticalAlign=middle;spacing=10;arcSize=12;" vertex="1" parent="1"><mxGeometry x="220" y="281" width="730" height="78" as="geometry" /></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#686D73;strokeWidth=2;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n4" value="&lt;b&gt;Ativação · API&lt;/b&gt;&lt;br&gt;PATCH /api/v1/consignado/ativar escolhe estratégia e ativa na Sky; Legado cria contrato resumido." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F9FC;strokeColor=#173288;fontColor=#26292C;fontSize=13;align=center;verticalAlign=middle;spacing=10;arcSize=12;" vertex="1" parent="1"><mxGeometry x="220" y="399" width="730" height="78" as="geometry" /></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#686D73;strokeWidth=2;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n5" value="&lt;b&gt;Parcelas e cobrança&lt;/b&gt;&lt;br&gt;Workers geram parcelas e lançam movimentação no Legado; Financeiro recebe faturamento após lançamento." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F9FC;strokeColor=#173288;fontColor=#26292C;fontSize=13;align=center;verticalAlign=middle;spacing=10;arcSize=12;" vertex="1" parent="1"><mxGeometry x="220" y="517" width="730" height="78" as="geometry" /></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#686D73;strokeWidth=2;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n6" value="&lt;b&gt;Cancelamento solicitado localmente&lt;/b&gt;&lt;br&gt;API cancela na Sky e no Legado; parcelas/recorrências pendentes são tratadas." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEBE2;strokeColor=#E06D36;fontColor=#26292C;fontSize=13;align=center;verticalAlign=middle;spacing=10;arcSize=12;" vertex="1" parent="1"><mxGeometry x="220" y="635" width="730" height="78" as="geometry" /></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#686D73;strokeWidth=2;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n7" value="&lt;b&gt;Cancelamento notificado pela Sky&lt;/b&gt;&lt;br&gt;POST /api/v1/webhook/cancelamento-seguro-sky; mapa informa que o sistema cancela do seu lado." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEBE2;strokeColor=#E06D36;fontColor=#26292C;fontSize=13;align=center;verticalAlign=middle;spacing=10;arcSize=12;" vertex="1" parent="1"><mxGeometry x="220" y="753" width="730" height="78" as="geometry" /></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#686D73;strokeWidth=2;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n8" value="&lt;b&gt;Fim&lt;/b&gt;&lt;br&gt;Status C após cancelamento. A estratégia Sky depende do mapeamento do tipo de seguro." style="ellipse;whiteSpace=wrap;html=1;fillColor=#E3F2E4;strokeColor=#06760B;fontColor=#0B1C54;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="220" y="871" width="730" height="78" as="geometry" /></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#686D73;strokeWidth=2;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>